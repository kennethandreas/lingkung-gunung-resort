APP_NAME="Lingkung Gunung"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lingkung_gunung
DB_USERNAME=lingkung
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lingkunggunung.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Lingkung Gunung ---------------------------------------------------
# Alamat admin panel (jangan pakai "admin")
ADMIN_PATH=kelola
# Wajib 2FA (Google Authenticator) untuk login admin. Jangan dimatikan di produksi.
ADMIN_REQUIRE_MFA=true
# Verifikasi email akun pelanggan: false = dimatikan sementara (belum ada pengirim email). WAJIB true di produksi.
CUSTOMER_EMAIL_VERIFICATION=false

# Midtrans Snap (ambil dari dashboard.sandbox.midtrans.com > Settings > Access Keys)
# JANGAN pernah menaruh nilai asli di file ini atau di kode.
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email transaksional (Brevo atau Resend, free tier). Saat development: MAIL_MAILER=log
RESEND_API_KEY=

# Monitoring error produksi (Sentry free tier) - diisi saat go-live
SENTRY_LARAVEL_DSN=

# Backup harian terenkripsi (spatie/laravel-backup). SIMPAN password ini di tempat aman:
# tanpa password, backup tidak bisa dibuka/dipulihkan.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=backups
BACKUP_NOTIFICATION_EMAIL=
# Folder berisi mysqldump bila tidak ada di PATH server (kosongkan bila sudah ada)
DB_DUMP_BINARY_PATH=

# Isi "*" di produksi bila server di belakang Cloudflare/proxy hosting
TRUSTED_PROXIES=
# true bila hosting tidak bisa menjalankan queue:work terus-menerus (antrean diproses cron tiap menit)
# Maks. booking online belum dibayar (hold aktif) per akun pelanggan, anti penimbunan stok
MAX_PENDING_HOLDS_PER_ACCOUNT=3
# Ulasan tamu: maks. foto per ulasan, ukuran per foto (KB), panjang komentar
REVIEW_MAX_PHOTOS=4
REVIEW_PHOTO_MAX_KB=5120
REVIEW_COMMENT_MAX=2000
QUEUE_VIA_SCHEDULER=false
