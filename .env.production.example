# =====================================================================
# Contoh .env PRODUKSI Lingkung Gunung (tanpa nilai rahasia).
# Salin ke server sebagai ".env", isi nilai yang kosong, lalu jalankan:
#   php artisan resort:cek-produksi
# JANGAN pernah commit file .env berisi nilai asli ke Git.
# =====================================================================

APP_NAME="Lingkung Gunung"
APP_ENV=production
APP_KEY=                       # php artisan key:generate (sekali saja, simpan cadangannya)
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://domain-resort.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# User aplikasi TANPA hak DROP/GRANT (lihat docs/DEPLOY.md bagian 3)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lingkung_gunung
DB_USERNAME=lingkung_app
DB_PASSWORD=
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email transaksional (Brevo / Resend free tier). Pengirim harus domain resort (SPF & DKIM).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@domain-resort.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Lingkung Gunung ---------------------------------------------------
ADMIN_PATH=kelola              # boleh diganti nama lain yang sulit ditebak, asal bukan "admin"
ADMIN_REQUIRE_MFA=true
CUSTOMER_EMAIL_VERIFICATION=true   # wajib true: akun pelanggan harus verifikasi email

# Midtrans PRODUKSI (dashboard.midtrans.com > Settings > Access Keys), bukan kunci SB-...
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

RESEND_API_KEY=
SENTRY_LARAVEL_DSN=

# Backup harian terenkripsi. Simpan password di pengelola password resort:
# tanpa password ini backup TIDAK bisa dipulihkan.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=backups           # tambahkan disk terpisah, mis. "backups,r2" (docs/DEPLOY.md bagian 6)
BACKUP_NOTIFICATION_EMAIL=

# "*" bila server hanya diakses lewat Cloudflare / proxy hosting
TRUSTED_PROXIES=*
# true untuk shared hosting tanpa queue worker permanen
# Maks. booking online belum dibayar (hold aktif) per akun pelanggan, anti penimbunan stok
MAX_PENDING_HOLDS_PER_ACCOUNT=3
# Ulasan tamu: maks. foto per ulasan, ukuran per foto (KB), panjang komentar
REVIEW_MAX_PHOTOS=4
REVIEW_PHOTO_MAX_KB=5120
REVIEW_COMMENT_MAX=2000
QUEUE_VIA_SCHEDULER=true
